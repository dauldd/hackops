DATABASE_PATH=./data/app.sqlite
OPENROUTER_API_KEY=
OPENROUTER_RESEARCH_MODEL=google/gemini-2.5-flash

# HeyGen presenter video (server only)
VIDEO_SCRIPT_MODEL=google/gemini-2.5-flash
VIDEO_MODEL=heygen/avatar-iv
VIDEO_VOICE_ID=
VIDEO_RESOLUTION=720p
VIDEO_ASPECT_RATIO=16:9
VIDEO_MAX_SECONDS=45
VIDEO_MAX_COST_USD=3.00
VIDEO_CONCURRENCY=1

# Optional overrides; default photo location: docs/images/presenter.png
PRESENTER_IMAGE_PATH=
PRESENTER_IMAGE_URL=
VIDEO_IMAGE_MAPPING=frame_images
VIDEO_STORAGE_PATH=./data/videos
# Optional: both needed to enable HTTPS callbacks. Polling always remains enabled.
PUBLIC_BASE_URL=
OPENROUTER_WEBHOOK_SECRET=
VIDEO_BANNED_PHRASES=revolutionary,limited time,game changer,game-changing,act now,book a demo,unlock,guaranteed,transform your business
